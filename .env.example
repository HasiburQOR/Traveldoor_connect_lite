# TravelDoor Connect — environment configuration
# Copy to .env at the project root. Real environment variables always win.
# Defaults below are dev-safe; review everything marked PRODUCTION.

# --- Core ---------------------------------------------------------------------
# PRODUCTION: generate with `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
DJANGO_SECRET_KEY=change-me-in-production
# PRODUCTION: must be false
DJANGO_DEBUG=true
# Comma separated host names
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Absolute origin used to build links inside emails (manage links etc.)
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Database -------------------------------------------------------------------
# Priority: DATABASE_URL -> POSTGRES_* -> SQLite (dev default).
# Dokploy: attach a managed PostgreSQL to the app and DATABASE_URL is injected.
#DATABASE_URL=postgresql://user:password@host:5432/traveldoor
#POSTGRES_DB=traveldoor
#POSTGRES_USER=traveldoor
#POSTGRES_PASSWORD=traveldoor
#POSTGRES_HOST=localhost
#POSTGRES_PORT=5432

# --- Email (company SMTP — SRS 1.2 / BRD 8) -------------------------------------
# Leave EMAIL_BACKEND unset to print emails to the console (dev default).
# Set to `smtp` and fill in the host details to send real mail.
#EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=TravelDoor Connect <bookings@traveldoor.example>
COMPANY_NAME=TravelDoor

# --- Platform defaults -----------------------------------------------------------
TIME_ZONE=UTC
# Background scheduler tick in seconds (runscheduler command)
SCHEDULER_INTERVAL_SECONDS=30

# --- Docker / production extras -------------------------------------------------
# Where uploaded host photos live. Must be a persistent volume in production
# (the compose files mount /app/media for you); defaults to ./media locally.
#DJANGO_MEDIA_ROOT=/app/media
# Host port the local compose stack publishes (docker-compose.yml)
#WEB_PORT=8000
# Gunicorn worker/thread counts inside the container
#GUNICORN_WORKERS=3
#GUNICORN_THREADS=2
# Extra CSRF origins when the app is reachable on several domains
# (PUBLIC_BASE_URL is always trusted automatically)
#DJANGO_CSRF_TRUSTED_ORIGINS=https://bookings.example.com
# Set false only when serving plain HTTP on a trusted LAN (Dokploy uses https)
#DJANGO_SSL_REDIRECT=true
